# Copy this file to .env.local and fill in real values.
# Never commit .env.local or any file containing real secrets.
# This file grows as each phase introduces the variables it actually needs.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Database (Supabase PostgreSQL via Drizzle) ---
# DATABASE_URL: Supabase "Transaction" pooler connection string (used at app runtime).
# DIRECT_URL: Supabase direct connection string (used for migrations).
# IMPORTANT: if the password contains a literal `$`, escape it as `\$` — Next.js
# expands unescaped `$VARIABLE` references in env files, which silently corrupts
# the password otherwise. See DATABASE.md.
DATABASE_URL=
DIRECT_URL=

# --- Supabase Auth ---
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
